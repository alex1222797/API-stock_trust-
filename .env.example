# Certificado CA de Aiven. En Render, subir como Secret File ca.pem.
MYSQL_SSL_CA=/etc/secrets/ca.pem

# Conserva tu secreto actual si tiene al menos 32 caracteres.
JWT_SECRET=
JWT_EXPIRE_MINUTES=480

BREVO_API_KEY=
