# Sólo en la API. Copia los valores reales de tu configuración actual.
MYSQL_HOST=tu-servicio.aivencloud.com
MYSQL_PORT=3306
MYSQL_USER=avnadmin
MYSQL_PASSWORD=
MYSQL_DATABASE=stock_trust
